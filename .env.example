# ==============================================================================
# LOREVERSE ORACLE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the actual values.
# DO NOT commit your .env file to version control.
# ==============================================================================

# --- SECURITY & APP SETTINGS ---
# Secret key used to sign and verify JWT tokens. (Required)
JWT_KEY=your_super_secret_jwt_key_here

# Allowed origins for frontend API requests. (Default: http://localhost:8080,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000


# --- POLYGLOT PERSISTENCE (DATABASES) ---

# Primary MySQL (Local instance)
# Default: localhost:3306
MYSQL_URL=jdbc:mysql://localhost:3306/loreverse_test
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password

# MariaDB (Local instance)
# Default: localhost:3308
MARIADB_URL=jdbc:mariadb://localhost:3308/arcyriea-loreverse-test
MARIADB_USERNAME=root
MARIADB_PASSWORD=your_password

# AlwaysData (Remote MariaDB/MySQL hosting) - (Required)
ALWAYSDATA_URL=jdbc:mysql://your-alwaysdata-url:port/db
ALWAYSDATA_USERNAME=your_user
ALWAYSDATA_PASSWORD=your_password

# MongoDB (Used for merging stream chats)
# Default: localhost:27017
MONGODB_URL=mongodb://localhost:27017/arcyriea-loreverse

# Redis (Used to validate and blacklist login authentications)
# Required for remote deployment. Default: localhost:6379
REDIS_URL=redis://localhost:6379

# Oracle Autonomous Data Warehouse (ADW/ATP) - (Optional)
# Default: localhost:1521
ORACLE_ADW_URL=jdbc:oracle:thin:@localhost:1521/LOREVERSE_TEST
ORACLE_ATP_URL=jdbc:oracle:thin:@localhost:1521/LOREVERSE_TEST
ORACLE_USERNAME=your_user
ORACLE_PASSWORD=your_password


# --- EXTERNAL INTEGRATIONS ---
# Assign values only for platforms being used.

# Twitch Integration
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_REDIRECT_URI=https://localhost:8080/auth/twitch/callback
TWITCH_CHANNEL=your_channel_name

# YouTube Integration
YOUTUBE_API_KEY=your_google_api_key
YOUTUBE_CHANNEL_ID=your_unique_channel_id


# --- LOGGING & DEBUGGING ---
# Sentry logging instance configuration
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_DSN=your_sentry_dsn_link
